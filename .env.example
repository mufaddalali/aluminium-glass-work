# Pooled Neon connection used by the application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct Neon connection used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Initial owner account. The password is hashed before it is stored.
SEED_OWNER_NAME="Shop Owner"
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="change-me-to-a-long-password"
SEED_DEMO_DATA="false"

# Session lifetime in days. The cookie stores a random secret; the database stores its hash.
SESSION_TTL_DAYS="7"
SESSION_COOKIE_NAME="shop_session"
